# Copy to .env and fill in real values. Never commit .env.

# --- Required everywhere (local dev and prod) ---
OPENAI_API_KEY=

POSTGRES_USER=lead_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lead_qualifier

# Only read if you run the API directly on the host (not via docker compose) --
# inside docker compose, DATABASE_URL/CHROMA_HOST/CHROMA_PORT are set for you
# from the values above and the service names.
# DATABASE_URL=postgresql://lead_user:change-me@localhost:5432/lead_qualifier
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# --- Prod only (docker-compose.prod.yml) ---
# Comma-separated list of origins allowed to call the API (your deployed frontend URL).
ALLOWED_ORIGINS=http://localhost:3000

# Public URL the frontend uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# n8n's public-facing address. If serving over plain HTTP+IP, N8N_HOST is the
# server IP and WEBHOOK_URL is http://<ip>:5678/. Behind the Caddy overlay with
# a domain, use N8N_HOST=n8n.yourdomain.com, N8N_PROTOCOL=https and
# WEBHOOK_URL=https://n8n.yourdomain.com/.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# --- Caddy overlay only (docker-compose.caddy.yml), requires a domain with
# DNS A records pointing at the server ---
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
N8N_DOMAIN=n8n.yourdomain.com
